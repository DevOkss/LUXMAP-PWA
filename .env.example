# ------------------------------------------------------------------
# LuxMap Student PWA — environment variables
#
# Local development (Vite dev server):
#   - Requests use a relative "/api" path proxied to the Laravel backend
#     by the Vite dev server (see vite.config.ts), so leave VITE_API_URL
#     commented out.
#   - Works from any device on the LAN, e.g. http://192.168.1.113:9000
#
# Production (Vercel):
#   - Set these in Vercel -> Project -> Settings -> Environment Variables.
#   - VITE_API_URL must point at the deployed Laravel backend. The PWA
#     appends paths like /api itself from this base.
# ------------------------------------------------------------------

# Full URL to the Laravel backend API, e.g.
# VITE_API_URL=https://your-laravel-domain.com/api

# QR payload encryption key — must match the backend QR_ENCRYPTION_KEY
# (64 hex chars).
# VITE_QR_KEY=

# Web Push VAPID public key — must match the backend VAPID_PUBLIC_KEY.
# VITE_VAPID_PUBLIC_KEY=
